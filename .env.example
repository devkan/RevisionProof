REVISIONPROOF_MODE=FIXTURE
REVISIONPROOF_RUNTIME_DIR=./runtime
REVISIONPROOF_MAX_UPLOAD_MIB=24
REVISIONPROOF_MAX_DURATION_SECONDS=60
REVISIONPROOF_GEMINI_TIMEOUT_SECONDS=60
REVISIONPROOF_MAX_IN_MEMORY_RUNS=64
REVISIONPROOF_MAX_NEW_RUNS_PER_MINUTE=12
REVISIONPROOF_MAX_VERIFICATION_ATTEMPTS_PER_RUN=6
REVISIONPROOF_MCP_TIMEOUT_SECONDS=30
REVISIONPROOF_MCP_MAX_ATTEMPTS=3
REVISIONPROOF_INTELLIGENCE_ENABLED=true
REVISIONPROOF_MEMORY_WORKSPACE=revisionproof-demo
REVISIONPROOF_MEMORY_SEARCH_ENGINE=hnsw
REVISIONPROOF_MEMORY_HNSW_MIN_ROWS=1000
REVISIONPROOF_MEMORY_QBIT_PRECISION=16
# LIVE saves are disabled unless a private 32+ character operator token is configured.
# REVISIONPROOF_MEMORY_WRITE_TOKEN=
REVISIONPROOF_GEMINI_MODEL=gemini-3.5-flash-lite
REVISIONPROOF_EMBEDDING_MODEL=text-embedding-005
REVISIONPROOF_GOOGLE_CLOUD_PROJECT=
REVISIONPROOF_GOOGLE_CLOUD_LOCATION=global
REVISIONPROOF_GCS_BUCKET=
REVISIONPROOF_CLICKHOUSE_HOST=
REVISIONPROOF_CLICKHOUSE_PORT=8443
REVISIONPROOF_CLICKHOUSE_SECURE=true
REVISIONPROOF_CLICKHOUSE_VERIFY=true
REVISIONPROOF_CLICKHOUSE_DATABASE=revisionproof
REVISIONPROOF_CLICKHOUSE_WRITER_USERNAME=revisionproof_writer_user
REVISIONPROOF_CLICKHOUSE_WRITER_PASSWORD=
REVISIONPROOF_CLICKHOUSE_WRITER_ROLE=revisionproof_writer
REVISIONPROOF_CLICKHOUSE_MCP_USERNAME=revisionproof_mcp_user
REVISIONPROOF_CLICKHOUSE_MCP_PASSWORD=
REVISIONPROOF_CLICKHOUSE_MCP_ROLE=revisionproof_mcp_reader
